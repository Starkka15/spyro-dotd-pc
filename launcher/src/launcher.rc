#include <windows.h>
#include <commctrl.h>
#include "launcher_res.h"
#include "game_selected.h"

1 ICON GAME_ICON_FILE
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION GAME_VERSION_RC
 PRODUCTVERSION GAME_VERSION_RC
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", GAME_DESC_A
            VALUE "ProductName", GAME_PRODUCT_A
            VALUE "FileVersion", GAME_VERSION
            VALUE "ProductVersion", GAME_VERSION
            VALUE "OriginalFilename", "launcher.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_LAUNCHER DIALOGEX 0, 0, 262, 262
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION GAME_TITLE_A
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Display", -1, 7, 7, 248, 106
    LTEXT           "Mode:", -1, 17, 23, 66, 8
    COMBOBOX        IDC_MODE, 88, 21, 158, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Window size:", IDC_SIZE_LBL, 17, 41, 66, 8
    COMBOBOX        IDC_WINSIZE, 88, 39, 158, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Sharpness:", -1, 17, 59, 66, 8
    COMBOBOX        IDC_SCALE, 88, 57, 158, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Graphics API:", -1, 17, 77, 66, 8
    COMBOBOX        IDC_BACKEND, 88, 75, 158, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "VSync (no tearing)", IDC_VSYNC, 17, 95, 228, 10

    GROUPBOX        "Controls", -1, 7, 119, 248, 72
    AUTOCHECKBOX    "Keyboard plays as a controller", IDC_MKB, 17, 135, 150, 10
    PUSHBUTTON      "Key bindings...", IDC_KEYS, 181, 133, 65, 14
    AUTOCHECKBOX    "Mouse turns the camera", IDC_MOUSE, 17, 153, 228, 10
    LTEXT           "Mouse sensitivity:", IDC_SENS_LBL, 17, 172, 66, 8
    CONTROL         "", IDC_SENS, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 84, 169, 132, 15
    LTEXT           "", IDC_SENS_VAL, 220, 172, 26, 8

    GROUPBOX        "Game", -1, 7, 197, 248, 40
    LTEXT           "", IDC_GAME_STATUS, 17, 212, 150, 8
    PUSHBUTTON      "Install game files...", IDC_GAMEFILES, 171, 209, 75, 14
    AUTOCHECKBOX    "Full log (for bug reports)", IDC_LOG, 17, 224, 150, 10

    PUSHBUTTON      "Saves folder", IDC_SAVES, 7, 243, 56, 14
    PUSHBUTTON      "Defaults", IDC_DEFAULTS, 67, 243, 46, 14
    DEFPUSHBUTTON   "Play", IDOK, 125, 243, 42, 14
    PUSHBUTTON      "Save", IDC_SAVE, 170, 243, 42, 14
    PUSHBUTTON      "Exit", IDCANCEL, 215, 243, 40, 14
END

IDD_IMPORT DIALOGEX 0, 0, 260, 66
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION
CAPTION "Installing the game files"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_IMPORT_TEXT, 10, 10, 240, 10, SS_PATHELLIPSIS
    CONTROL         "", IDC_IMPORT_BAR, "msctls_progress32", WS_BORDER, 10, 24, 240, 12
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 44, 50, 14
END
